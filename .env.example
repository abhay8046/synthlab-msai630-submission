# Use OpenRouter credits for SynthLab without separate OpenAI API billing.
# Create a dedicated LIMITED key at https://openrouter.ai/keys
# Never commit .env, Streamlit secrets.toml, or share real keys in chat.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
SYNTHLAB_GENERATION_PASSWORD=

# Legacy alternative only (leave unset for OpenRouter):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1

# In Streamlit Community Cloud, put TOML secrets into the app's Secrets settings.
